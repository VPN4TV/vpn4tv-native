{
  "route": {
    "final": "select",
    "rules": [
      {"action": "sniff"},
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "outbound": "direct",
        "network": "udp"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "dns-direct"}
  },
  "log": {
    "level": "info",
    "timestamp": true
  },
  "outbounds": [
    {
      "outbounds": [
        "OL 3",
        "AWG 3",
        "OLC 3",
        "TT 3"
      ],
      "interval": "5m",
      "tag": "auto",
      "type": "urltest",
      "url": "https://cp.cloudflare.com/",
      "tolerance": 50
    },
    {
      "default": "auto",
      "outbounds": [
        "auto",
        "OL 3",
        "AWG 3",
        "OLC 3",
        "TT 3"
      ],
      "tag": "select",
      "type": "selector"
    },
    {
      "server": "127.0.0.127",
      "bind_interface": "lo",
      "server_port": 31000,
      "tag": "OL 3",
      "type": "socks",
      "version": "5",
      "network": "tcp"
    },
    {
      "server": "127.0.0.127",
      "bind_interface": "lo",
      "domain_strategy": "ipv4_only",
      "server_port": 32000,
      "tag": "AWG 3",
      "type": "socks",
      "version": "5",
      "network": "tcp"
    },
    {
      "server": "127.0.0.127",
      "bind_interface": "lo",
      "domain_strategy": "ipv4_only",
      "server_port": 33000,
      "tag": "OLC 3",
      "type": "socks",
      "version": "5",
      "network": "tcp"
    },
    {
      "server": "127.0.0.127",
      "bind_interface": "lo",
      "domain_strategy": "ipv4_only",
      "server_port": 34000,
      "tag": "TT 3",
      "type": "socks",
      "version": "5",
      "network": "tcp"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "dns": {
    "servers": [
      {
        "server": "8.8.8.8",
        "domain_resolver": "dns-direct",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "server": "9.9.9.9",
        "tag": "dns-direct",
        "type": "udp"
      }
    ],
    "rules": [{
      "server": "dns-direct",
      "outbound": "any"
    }],
    "strategy": "ipv4_only"
  },
  "inbounds": [{
    "strict_route": true,
    "stack": "mixed",
    "address": [
      "172.19.0.1/30",
      "fdfe:dcba:9876::1/126"
    ],
    "auto_route": true,
    "tag": "tun-in",
    "type": "tun"
  }]
}