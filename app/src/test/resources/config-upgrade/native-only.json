{
  "route": {
    "final": "select",
    "rules": [
      {"action": "sniff"},
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "dns-direct"}
  },
  "log": {
    "level": "info",
    "timestamp": true
  },
  "outbounds": [
    {
      "outbounds": ["SS 1"],
      "interval": "5m",
      "tag": "auto",
      "type": "urltest",
      "url": "https://cp.cloudflare.com/",
      "tolerance": 50
    },
    {
      "default": "auto",
      "outbounds": [
        "auto",
        "SS 1"
      ],
      "tag": "select",
      "type": "selector"
    },
    {
      "server": "192.0.2.30",
      "password": "secret",
      "method": "aes-256-gcm",
      "server_port": 8388,
      "tag": "SS 1",
      "type": "shadowsocks"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "dns": {
    "servers": [
      {
        "server": "8.8.8.8",
        "domain_resolver": "dns-direct",
        "detour": "select",
        "tag": "dns-remote",
        "type": "https"
      },
      {
        "server": "9.9.9.9",
        "tag": "dns-direct",
        "type": "udp"
      },
      {
        "inet6_range": "fc00::/18",
        "inet4_range": "198.18.0.0/15",
        "tag": "dns-fakeip",
        "type": "fakeip"
      }
    ],
    "rules": [
      {
        "server": "dns-direct",
        "outbound": "any"
      },
      {
        "action": "reject",
        "query_type": [
          "HTTPS",
          "SVCB"
        ]
      },
      {
        "server": "dns-fakeip",
        "query_type": [
          "A",
          "AAAA"
        ]
      }
    ]
  },
  "experimental": {"cache_file": {
    "store_fakeip": true,
    "enabled": true
  }},
  "inbounds": [{
    "strict_route": true,
    "stack": "mixed",
    "address": [
      "172.19.0.1/30",
      "fdfe:dcba:9876::1/126"
    ],
    "auto_route": true,
    "tag": "tun-in",
    "type": "tun"
  }]
}