<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup on Android 6 to 8 (android:fullBackupContent): nothing. These
  versions cannot encrypt a backup on the device, and a key link is a
  credential (owner, 2026-11-08). Android 9 to 11 read xml-v28/backup_rules.xml,
  Android 12 and newer data_extraction_rules.xml.
  With no include, every file not excluded would go: so all is excluded.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
