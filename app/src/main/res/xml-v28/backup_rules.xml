<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup on Android 9 to 11 (android:fullBackupContent; xml/ is Android 6
  to 8). Android 12 and newer read data_extraction_rules.xml: keep the lists the
  same. Every item goes only into a backup encrypted on the device
  (requireFlags="clientSideEncryption": a screen lock is set): a key link is a
  credential (owner, 2026-11-08). Without a screen lock, as on most TVs, the
  keys stay on the device.

  Only what is included goes (with a database Android takes its -journal and
  -wal files too). Included: the keys (profiles.db and their
  configs in files/profiles, bridge files with them), the settings
  (settings.db; RestoreAgent marks a restore and RestoredData resets the
  settings that describe the old device), the server chosen for each key
  (server_selection.xml) and what the key's server said about it
  (sub_userinfo.xml).

  Left on the device: the installation ID (shared_prefs/hwid.xml: a new
  device gets its own, as Google's Auto Backup guide asks for device IDs),
  the core's working files with cache.db (FakeDNS names of visited sites,
  in internal or external storage), the core's copy of the running config,
  rule sets, caches, crash files and the other shared preferences (DNS cache,
  storage and session flags, probes).
-->
<full-backup-content>
    <include domain="database" path="profiles.db" requireFlags="clientSideEncryption" />
    <include domain="database" path="settings.db" requireFlags="clientSideEncryption" />
    <include domain="file" path="profiles" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="server_selection.xml" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="sub_userinfo.xml" requireFlags="clientSideEncryption" />
</full-backup-content>
