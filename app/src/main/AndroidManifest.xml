<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TrustTunnel AAR declares minSdk 24; the app is 23. Allow the merge and
         gate every TrustTunnel call on Build.VERSION.SDK_INT >= 24. -->
    <uses-sdk tools:overrideLibrary="com.adguard.trusttunnel" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- ACCESS_WIFI_STATE implies Wi-Fi as required hardware, and Google Play
         would then hide the app from TV boxes with Ethernet only (Google's TV
         hardware guide). Without Wi-Fi the app reads no Wi-Fi state
         (Application.wifiManager is null). -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- trusttunnel-client.aar asks for it, but we only use its client as a
         SOCKS bridge and run no data-sync foreground service; Play refuses
         a release until every foreground-service permission is declared. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Android TV: the app's channel on the home screen (TvProvider, a normal
         permission; nothing on a phone, which has no TvProvider). The library
         also asks to read TV listings, which the app does not need: its own
         channel is readable without it. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission
        android:name="com.android.providers.tv.permission.READ_EPG_DATA"
        tools:node="remove" />

    <!-- enableOnBackInvokedCallback: predictive back on phones and tablets
         (Android 13+; Android 16 turns it on for targetSdk 36 anyway): the back
         gesture previews where it leads, and the opt-out Google calls temporary
         is gone. Then BACK no longer reaches MainActivity.dispatchKeyEvent on
         Android 13+, so on a TV with Android 13+ the guard against a remote's
         double BACK is a callback of its own (MainActivity.tvBackGuard).
         Backup: Auto Backup with rules (keys and settings go; the installation
         ID, the core's cache with visited names and caches stay), the same
         for Android 6-11 (fullBackupContent) and 12+ (dataExtractionRules).
         RestoreAgent only marks a restore (fullBackupOnly keeps Auto Backup);
         RestoredData then resets what described the old device. -->
    <application
        android:name=".Application"
        android:allowBackup="true"
        android:backupAgent=".bg.RestoreAgent"
        android:fullBackupOnly="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@mipmap/tv_banner"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <!-- Theme.VPN4TV.Starting: the launch screen, AppTheme once MainActivity
             starts. configChanges: a TV remote or a keyboard that sleeps and
             wakes (Bluetooth) or is plugged in changes the keyboard and
             navigation configuration; the screen stays as it is instead of
             being recreated (Google's TV controllers guide). -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.VPN4TV.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Import subscription links: vpn://, wg://, vless://, vmess://,
                 trojan://, hy2://, hysteria2://, ss://. Used by adb to push
                 test subscriptions and by any share-sheet integration. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vpn" />
                <data android:scheme="vpn4tv" />
                <data android:scheme="wg" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="trojan" />
                <data android:scheme="hy2" />
                <data android:scheme="hysteria2" />
                <data android:scheme="ss" />
            </intent-filter>
            <!-- Import wg-quick / AmneziaWG .conf files from the filesystem.
                 Used by adb (`am start -a VIEW -d file:///data/local/tmp/x.conf`)
                 and by file-picker flows. A file:// path is matched by its name. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\.wg" />
                <data android:pathPattern=".*\\.vpn" />
            </intent-filter>
            <!-- content:// carries no file name to match, only a type. With
                 "*/*" this filter took any content link — a calendar date
                 offered "Open with VPN4TV". The types file managers give a
                 .conf / .wg / .vpn file: -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-wireguard-config" />
            </intent-filter>
        </activity>

        <service
            android:name=".bg.VPNService"
            android:exported="false"
            android:foregroundServiceType="systemExempted"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="ForegroundServicePermission">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".bg.ProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="proxy" />
        </service>

        <!-- Quick Settings tile (phones and tablets, Android 7+): connect and
             disconnect from the shade. Active: redrawn when the VPN changes,
             not bound each time the panel opens. -->
        <service
            android:name=".bg.VpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_vpn4tv"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>

        <!-- Home-screen widget (Jetpack Glance): the VPN's state and a connect button. -->
        <receiver
            android:name=".widget.VpnWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vpn_widget_info" />
        </receiver>

        <receiver
            android:name=".bg.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Android TV's home screen: the launcher asks for the app's default
             channel after an install, and says when the user removed a card. -->
        <receiver
            android:name=".tv.QuickConnectReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" />
                <action android:name="android.media.tv.action.PREVIEW_PROGRAM_BROWSABLE_DISABLED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- The pictures of the channel's cards, which the TV launcher loads:
             read only, the PNG files drawn for the channel and nothing else. -->
        <provider
            android:name=".tv.ChannelArtProvider"
            android:authorities="${applicationId}.channelart"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.cache"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cache_paths" />
        </provider>

    </application>

</manifest>
